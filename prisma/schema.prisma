// Prisma schema for MediFlow Core: QR-Based Patient Assistance & Nurse Calling System
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestType {
  NURSE_CALL
  DRINKING_WATER
  HELP_OUT_OF_BED
  GENERAL_ASSISTANCE
  OTHER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Nurse {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  employeeId   String   @unique
  passwordHash String
  department   String?  @default("Inpatient Care")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([employeeId])
}

model Bed {
  id         String   @id @default(uuid())
  roomNumber String
  bedNumber  String
  qrToken    String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  requests PatientAssistanceRequest[]

  @@unique([roomNumber, bedNumber])
  @@index([qrToken])
}

model PatientAssistanceRequest {
  id             String         @id @default(uuid())
  bedId          String
  requestType    RequestType
  customNote     String?
  status         RequestStatus  @default(PENDING)
  submittedAt    DateTime       @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  bed Bed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@index([bedId])
  @@index([status])
  @@index([submittedAt])
}
